{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "play.unrealfilament.art" }],
      "destination": "/play/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "play.unrealfilament.art" }],
      "destination": "/play/$1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.unrealfilament.art" }],
      "destination": "https://unrealfilament.art/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*.:ext(webp|png|jpg|jpeg|svg|woff2|css|js|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
